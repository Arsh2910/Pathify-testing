PORT=5000
MONGODB_URI=your-mongodb-connection-string
JWT_EXPIRES_IN=30d
JWT_SECRET=your-jwt-secret-key

GEMINI_API_KEY=your-gemini-api-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id-here

# Frontend URL (Used for 1-click password reset email links)
CLIENT_URL=http://localhost:5173

# ========================================================
# REAL EMAIL DELIVERY CONFIGURATION
# ========================================================
# OPTION 1: Resend API (Free 3,000 emails/month — https://resend.com)
# Sign up, grab your API Key (e.g. re_xxxx), and paste it below:
RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM="GoalWeave <onboarding@resend.dev>"

# OPTION 2: Gmail (Free & Easiest with personal Gmail)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to "App Passwords": https://myaccount.google.com/apppasswords
# 3. Create an app password named "GoalWeave" (generates a 16-character code)
# 4. Fill in the two lines below:
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# OPTION 2: Generic SMTP (SendGrid, Brevo, Mailgun, Mailtrap, AWS SES)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_password_or_api_key
# EMAIL_FROM="GoalWeave <no-reply@goalweave.app>"
