{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "allowJs": true,
    "checkJs": false,

    "rootDir": "./backend/src",
    "outDir": "./backend/dist",

    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },

  "include": ["backend/src/**/*"],
  "exclude": ["backend/node_modules", "backend/dist"]
}
